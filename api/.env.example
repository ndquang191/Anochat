# Server
SERVER_PORT=8080
SERVER_ENV=development
SERVER_CLIENT_URL=http://localhost:3000
# Required in addition to development mode before the reset CLI can run.
ALLOW_DATABASE_RESET=false

# PostgreSQL (matches docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=anochat
DATABASE_SSL_MODE=disable

REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# OAuth and session tokens. Dev auth is rejected unless SERVER_ENV=development.
DEV_AUTH_ENABLED=true
OAUTH_JWT_SECRET=anochat-local-dev-secret-change-before-production
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
OAUTH_ACCESS_TOKEN_EXPIRY=15m
OAUTH_REFRESH_TOKEN_EXPIRY=720h

# Application limits
CHAT_MESSAGE_RATE_LIMIT=10
CHAT_MAX_MESSAGE_LENGTH=1000
USER_MIN_AGE=10
USER_MAX_AGE=99
SECURITY_RATE_LIMIT=100

# Web Push. Generate one VAPID pair and keep it stable across deployments.
WEB_PUSH_ENABLED=true
WEB_PUSH_VAPID_PUBLIC_KEY=BNJmGzVeIygGxxz_q_MdVejxPBS_VrsVKpEWaC8tyP9AXlmfAeV1eFZl9CLgKBeJ-26pmq_cbhubq3-WtnE2E34
WEB_PUSH_VAPID_PRIVATE_KEY=_53Oiw_8pqzYNlje6dRl8w_Gzqv4MSZSSE-RatsxB8Q
WEB_PUSH_VAPID_SUBJECT=mailto:ndquang191@gmail.com
