{
  "title": "Anochat Dashboard",
  "uid": "anochat-main",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active WS Connections",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "anochat_active_ws_connections",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Users",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "anochat_users_total",
          "legendFormat": "users"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue Size",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "anochat_queue_size",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "New Registrations (total)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "anochat_new_registrations_total",
          "legendFormat": "new users"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active Connections Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "anochat_active_ws_connections",
          "legendFormat": "active connections"
        },
        {
          "datasource": "Prometheus",
          "expr": "anochat_queue_size",
          "legendFormat": "queue size"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "New Registrations Rate (per minute)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(anochat_new_registrations_total[1m]) * 60",
          "legendFormat": "registrations/min"
        }
      ]
    },
    {
      "id": 7,
      "type": "histogram",
      "title": "Match Duration Distribution",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(anochat_match_duration_seconds_bucket[5m])",
          "legendFormat": "{{le}}s",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Avg Match Duration (last 5m)",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 8 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(anochat_match_duration_seconds_sum[5m]) / rate(anochat_match_duration_seconds_count[5m])",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Total Matches (last 5m)",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 8 },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(anochat_match_duration_seconds_count[5m])",
          "legendFormat": "matches"
        }
      ]
    }
  ]
}
