API_PORT=8080
SERVER_CLIENT_URL=https://anochat.example.com

DATABASE_HOST=db.example.com
DATABASE_PORT=5432
DATABASE_USER=anochat
DATABASE_PASSWORD=change-me
DATABASE_NAME=anochat
DATABASE_SSL_MODE=require

REDIS_URL=redis.example.com:6379
REDIS_PASSWORD=change-me
REDIS_DB=0

OAUTH_GOOGLE_CLIENT_ID=change-me
OAUTH_GOOGLE_CLIENT_SECRET=change-me
OAUTH_REDIRECT_URL=https://api.anochat.example.com/auth/callback
OAUTH_JWT_SECRET=change-me-use-a-long-random-string

# Generate once and keep this VAPID pair stable across deployments.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
